{
  "name": "HokmCardBot",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "بازی خوکم (Hokm) — a Persian trick-taking card game as a Telegram Mini App on the tgcloud serverless platform",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "status": "tgcloud status",
    "deploy": "npm run build && tgcloud push",
    "migrate": "tgcloud migrate",
    "run": "tgcloud run"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vazirmatn": "^33.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tgcloud/cli": "^0.2.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  }
}
